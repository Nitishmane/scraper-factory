# Copy to .env and fill in. Never commit .env.

# ---- Bright Data ------------------------------------------------------------
# API key: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=
# Docs call the binary `bdata`, the GitHub README calls it `brightdata`.
# Check `brightdata --help` / `bdata --help` and set whichever you have.
BRIGHTDATA_BIN=brightdata
BRIGHTDATA_TIMEOUT=180

# Collector IDs from `brightdata scraper create` (also pin these in CLAUDE.md).
# CHANNEL scrapes any streamingtvguides.com/Channel/<ID> page (one shared collector --
# every channel page has the same structure, ~12 days of programs each); CATALOG scrapes
# philo.com/go/allshows for title -> record-URL mapping.
SCRAPER_STUDIO_COLLECTOR_ID_CHANNEL=
SCRAPER_STUDIO_COLLECTOR_ID_PHILO_CATALOG=

# Channel pages scraped per provider per run (cost control; ~455 programs per page)
GUIDE_MAX_CHANNELS=25

# NOTE: the webapp has no database of its own -- it reads the ranked_title entities
# straight from Port's Context Lake using the same PORT_* credentials (set them in
# webapp/.env.local for local dev, or as Vercel env vars for deploys).

# ---- TMDB (ranking enrichment) -----------------------------------------------------
# Free API key: https://www.themoviedb.org/settings/api. Optional -- without it the
# ranker falls back to guide-only heuristics (airing volume, prime time, NEW badges).
TMDB_API_KEY=

# ---- Port ------------------------------------------------------------------
# app.port.io -> "..." (top right) -> Credentials
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_BASE=https://api.port.io/v1

# Where Port's automation and self-service action POST to. Use a tunnel URL
# (ngrok/cloudflared) when running the factory on a laptop.
HEAL_WEBHOOK_URL=http://localhost:8000/heal
BUILD_WEBHOOK_URL=http://localhost:8000/build
FEATURE_WEBHOOK_URL=http://localhost:8000/feature
RUN_WEBHOOK_URL=http://localhost:8000/run
CATALOG_WEBHOOK_URL=http://localhost:8000/catalog
PUBLISH_WEBHOOK_URL=http://localhost:8000/publish

# ---- SigNoz ----------------------------------------------------------------
OTEL_SERVICE_NAME=scraper-factory

# Self-hosted (recommended: no key, no trial clock, survives venue wifi)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SIGNOZ_UI_URL=http://localhost:8080

# SigNoz Cloud instead — note BOTH gRPC and HTTP use port 443, not 4317/4318
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-key>
# SIGNOZ_UI_URL=https://<your-org>.signoz.cloud

# ---- Local -----------------------------------------------------------------
STATE_DB=out/factory.db

# Public URL serving fixtures/. Bright Data collectors run in Bright Data's cloud and
# CANNOT reach localhost, so `make verify` and `make demo-drift` need the fixtures
# exposed through a tunnel:
#   terminal 1: make serve-fixtures                            # fixtures/ on :9000
#   terminal 2: cloudflared tunnel --url http://localhost:9000 # prints an https URL
# Leave empty and `make verify` falls back to the live sites (not reproducible).
FIXTURE_BASE_URL=

# Shared secret gating every webhook endpoint; bootstrap bakes it into the Port/SigNoz URLs
FACTORY_WEBHOOK_TOKEN=generate-with-openssl-rand-hex-24
